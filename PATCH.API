fetch("https://jsonplaceholder.typicode.com/posts/1", {
  method: "PATCH",
  headers: {
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    title: "New Title"
  })
})
.then((response) => response.json())
.then((data) => {
  console.log(data);
})
.catch((error) => {
  console.log(error);
});
