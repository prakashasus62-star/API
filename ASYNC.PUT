async function addPost() {
  try {
    const response = await fetch("https://jsonplaceholder.typicode.com/posts", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        title: "API",
        body: "JavaScript",
        userId: 1
      })
    });

    const data = await response.json();
    console.log(data);

  } catch (error) {
    console.log(error);
  }
}

addPost();
